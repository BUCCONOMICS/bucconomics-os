{
  "name": "bucconomics-os",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "prepare": "husky"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/testing-library__react": "^10.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-solidity": "^2.3.1",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "nanoid": "^3.3.17",
    "postcss": "^8.5.23",
    "sharp": "^0.35.0",
    "@eslint/eslintrc": {
      "js-yaml": "^4.3.1"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "^1.1.16"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "^5.0.7"
    },
    "undici": "^6.28.0",
    "uuid": "^11.1.1"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json,md}": "prettier --write",
    "*.sol": "forge fmt"
  },
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "contracts"
  ]
}
