{
  "name": "create-bucc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "create-bucc": "./dist/bin/create-bucc.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "format": "prettier --write \"src/**/*.{ts,md}\" \"README.md\""
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1112.0",
    "@aws-sdk/client-sts": "3.1112.0",
    "@inquirer/prompts": "7.10.1",
    "@pulumi/pulumi": "3.258.0",
    "@repo/bucc-infra": "*",
    "@repo/bucc-infra-aws": "*",
    "semver": "^7.7.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.3",
    "@types/semver": "^7.7.1",
    "eslint": "^9.39.1",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.12",
    "typescript": "5.9.2"
  }
}
